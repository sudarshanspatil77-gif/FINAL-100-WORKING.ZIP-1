# Angel One SmartAPI (never share these values in chat or commit them to GitHub)
ANGEL_API_KEY=your_api_key
ANGEL_CLIENT_CODE=your_client_code
ANGEL_PIN=your_pin_or_mpin
ANGEL_TOTP_SECRET=your_totp_secret_base32

# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# SAFETY: false = paper/simulated orders; set true only after testing all endpoints and order sizing
LIVE_TRADING_ENABLED=false
TIMEFRAME_MIN=5
NIFTY_INDEX_TOKEN=99926000
NIFTY_INDEX_SYMBOL=Nifty 50
ACCOUNT_CAPITAL_INR=50000
RISK_PERCENT=0.5
RISK_REWARD=2.0
DAILY_LOSS_LIMIT_PERCENT=1.5
MAX_TRADES_PER_DAY=3
MAX_OPTION_PREMIUM=500
BOT_STATE_PATH=bot_state.json
